# انسخ الملف ده باسم .env وعدّل اللي محتاجه. (.env متتجاهل في git ومش هيتنشر)

# --- Darijat (مدفوع) ---
# DARIJAT_API_TOKEN=
# DARIJAT_API_VERSION=v2
# DARIJAT_VOICES=سارة,مريم,طارق
# DARIJAT_STYLE_MODE=text_command   # أو none

# --- VoiceTut ---
# VOICETUT_NUM_STEP=32              # أعلى = جودة أحسن وأبطأ

# --- Chatterbox ---
# CHATTERBOX_EGYPTIAN=1             # النسخة المصرية (صوت واحد)
